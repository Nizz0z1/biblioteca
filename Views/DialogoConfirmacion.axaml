<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BibliotecaPersonal.Views.DialogoConfirmacion"
        Title="Confirmar eliminación"
        Width="400" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="20" Spacing="18">
        <TextBlock x:Name="TxtMensaje" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancelar" Click="BtnCancelar_Click" IsCancel="True" />
            <Button Content="Eliminar" Classes="accent" Click="BtnAceptar_Click" />
        </StackPanel>
    </StackPanel>
</Window>
